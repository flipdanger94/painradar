# Required for durable data. Neon connection string (never NEXT_PUBLIC).
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Billing requires an HTTPS origin in production: no path, query, credentials or fragment.
# HTTP loopback origins are accepted only outside production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GEMINI_API_KEY=
GEMINI_TIER=free
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
AI_DAILY_BUDGET_USD=5
# Free-tier usage is recorded at zero cost. For GEMINI_TIER=paid, set actual rates.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
EMBEDDING_INPUT_USD_PER_MILLION=
SOURCE_USER_AGENT=PainRadar/0.1 (contact: your-email@example.com)
GITHUB_SOURCE_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_FOUNDER=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Competitor web research: configure actual provider pricing and model context ceiling.
GEMINI_RESEARCH_MODEL=gemini-3.5-flash-lite
WEB_SEARCH_USD_PER_CALL=
RESEARCH_MAX_CONTEXT_TOKENS=
RESEARCH_INPUT_USD_PER_MILLION=
RESEARCH_OUTPUT_USD_PER_MILLION=

# 32 random bytes encoded as base64; keep stable to decrypt saved webhook secrets.
WEBHOOK_ENCRYPTION_KEY=

# Opt-in bounded maintenance; preserves attached evidence and billing records.
DATA_MAINTENANCE_ENABLED=false
SIGNAL_PAYLOAD_RETENTION_DAYS=90
AI_CACHE_RETENTION_DAYS=30
JOB_LOG_RETENTION_DAYS=90
